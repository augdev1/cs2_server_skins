# ==========================================
# CS2 WeaponPaints Web - Variáveis de Ambiente
# ==========================================

# Configurações do Banco de Dados MySQL / MariaDB (Servidor CS2)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=cs2_weaponpaints

# Steam Web API Key (Obtenha em: https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your_steam_api_key_here

# URLs da Aplicação
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Chave secreta para assinatura dos Tokens JWT
JWT_SECRET=change-this-to-a-very-secure-random-secret-key-2026
